{#
 # Patient Portal Appointment Item Template Override
 # Adds televisit join button for televisit appointments
 #
 # @package OpenEMR\Modules\PahoJitsiTelevisit
 # @license GNU General Public License 3
#}
<div class="card m-0 col-12 col-md-6 col-lg-4">
    <div class="card-header">
        {% if past == false %}
        <a href="#" onclick="editAppointment({{ appt.mode | attr_js }},{{ appt.pc_eid | attr_js }})" title="{{ appt.etitle | attr }}">
            <i class='float-right fa fa-edit fa-lg {% if appt.pc_recurrtype > 0 %} text-danger {% else %} text-success {% endif %} bg-light font-weight-light'></i>
        </a>
        {% endif %}
    </div>
    <div class="card-body p-0 font-weight-bold">
        <p>
            {{ appt.appointmentDate | text }}<br>
            {{ appt.appointmentType | text }}<br>
            {{ appt.provider | text }}<br>
            {{ appt.status | text }}
        </p>

        {# Televisit join button #}
        {% if appt.showTelevisit %}
        <div style="margin-top: 10px; padding-top: 10px; border-top: 1px solid #e0e0e0;">
            <span class="portal-televisit-badge">
                <i class="fa fa-video-camera"></i> {{ 'Televisit' | xlt }}
            </span>
            <a href="{{ appt.televisitUrl | attr }}"
               target="_blank"
               class="portal-televisit-button"
               style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; font-weight: 600; margin-top: 8px; width: 100%;">
                <i class="fa fa-video-camera" aria-label="Video"></i>
                {{ 'Join Televisit' | xlt }}
            </a>
        </div>
        {% endif %}
    </div>
</div>

